    "runner": "tsx apps/runner/src/index.ts",
    "purity": "node scripts/check-purity.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.8.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
