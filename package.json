{
  "name": "artificial-ocean",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Soft-bodied creatures grown from genomes, evolved by how well they swim.",
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
